# Copy to .env.local for local development. Never commit real secrets.

# --- Database (MariaDB) ---
# Local dev via compose.dev.yaml maps a throwaway MariaDB to localhost:3306.
DATABASE_URL="mysql://muster:muster@localhost:3306/muster"
# Production uses the HOST's central MariaDB instead (no db container; the app
# runs host-networked — see compose.yaml) with TWO accounts (docs/deploy.md §5):
# a DML-only runtime account for the app, and a DDL-capable one for migrations.
#   DATABASE_URL="mysql://musteru:<password>@127.0.0.1:3306/muster"
#   MIGRATE_DATABASE_URL="mysql://musterm:<password>@127.0.0.1:3306/muster"
# (MIGRATE_DATABASE_URL is prod-only; local dev migrates with DATABASE_URL's
# full-privilege dev container user via `npm run db:migrate`.)

# --- App ---
# Public base URL of the app (used by Auth.js for callback URLs).
NEXTAUTH_URL="http://localhost:3000"
# Random secret for session/JWT signing: `openssl rand -base64 32`
# (Production refuses to boot on the committed dev default — see env-guard.ts.)
AUTH_SECRET="change-me-in-local-and-prod"

# --- Google OAuth (student + admin sign-in, hd=wisc.edu) ---
# The same OAuth client is reused for the admin Drive grant. Register BOTH
# redirect URIs on it: <base>/api/auth/callback/google and <base>/api/drive/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Evidence storage (Google Drive relay; §12) ---
# 256-bit key for encrypting the admin Drive refresh token at rest.
# Generate: `openssl rand -base64 32`. A dev default is used if unset locally;
# production refuses to boot on it (env-guard.ts), and compose requires it.
ENCRYPTION_KEY=""
# Destination Drive folder id for evidence (a department Shared Drive folder).
# If empty, uploads land in the connected admin's My Drive root.
DRIVE_FOLDER_ID=""

# --- Resend (magic-link fallback email) ---
# API key is tied to the verified sending domain; EMAIL_FROM must be on that domain.
RESEND_API_KEY=""
EMAIL_FROM="GDEC Scheduling <no-reply@re.hauge.rocks>"

# --- Admin allowlist (comma-separated wisc.edu emails) ---
ADMIN_EMAILS=""

# --- Manual digest trigger (optional; docs/deploy.md §7) ---
# Bearer token for forcing a digest run via POST /api/cron/change-digest.
# The daily run is the in-app scheduler and needs no setup. Generate:
# `openssl rand -base64 32`. Leave empty to keep the endpoint refusing.
CRON_SECRET=""

# --- Dev login bypass (LOCAL ONLY) ---
# Set to "1" to enable a no-OAuth sign-in at /dev-login for testing protected
# pages. Ignored entirely when NODE_ENV=production. Leave empty otherwise.
DEV_LOGIN_ENABLED=""

# --- Digest scheduler in dev (LOCAL ONLY) ---
# Set to "1" to run the in-app change-digest scheduler outside production,
# e.g. to watch a live run locally. Production always runs it. Leave empty.
DIGEST_SCHEDULER_DEV=""

# --- Font Awesome Pro Kit (BUILD-TIME only; not a runtime secret) ---
# Auth token for installing the @awesome.me kit package from npm.fontawesome.com.
# Read by `.npmrc` during `npm ci`/`npm install`, and mounted into the Docker
# `deps` stage as a BuildKit secret (compose `secrets.fa_token`). NOT needed by
# the running app. Get it from your kit's "package manager" setup panel.
# Local dev tip: set it in your shell/user env (or ~/.npmrc) instead of here.
FONTAWESOME_PACKAGE_TOKEN=""
