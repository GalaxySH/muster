# Copy to .env.local for local development. Never commit real secrets.

# --- Database (MariaDB) ---
# Local dev via docker-compose maps MariaDB to localhost:3306.
DATABASE_URL="mysql://muster:muster@localhost:3306/muster"

# --- App ---
# Public base URL of the app (used by Auth.js for callback URLs).
NEXTAUTH_URL="http://localhost:3000"
# Random secret for session/JWT signing: `openssl rand -base64 32`
AUTH_SECRET="change-me-in-local-and-prod"

# --- Google OAuth (student + admin sign-in, hd=wisc.edu) ---
# Phase 1 can run without these; auth wiring lands in a later phase.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Resend (magic-link fallback email, Phase 2/3) ---
RESEND_API_KEY=""
EMAIL_FROM="GDEC Scheduling <sched@hauge.rocks>"

# --- Admin allowlist (comma-separated wisc.edu emails) ---
ADMIN_EMAILS=""
